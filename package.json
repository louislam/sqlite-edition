{
  "name": "sqlite-edition",
  "version": "1.0.2",
  "description": "Rust-style editions for SQLite: one call, sane 2026 defaults on top of node:sqlite",
  "keywords": [
    "sqlite",
    "node:sqlite",
    "edition",
    "defaults",
    "pragma",
    "wal",
    "foreign-keys"
  ],
  "author": "Louis Lam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louislam/sqlite-edition.git"
  },
  "homepage": "https://github.com/louislam/sqlite-edition#readme",
  "bugs": {
    "url": "https://github.com/louislam/sqlite-edition/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
